{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": false, "isolatedModules": true, "noEmit": true
  },
  "include": ["src"]
}
