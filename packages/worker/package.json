{
  "name": "@bc/worker",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bc/server-core": "workspace:*",
    "@bc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "main": "dist/jobs.js",
  "types": "dist/jobs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    }
  }
}