# Postgres
DATABASE_URL=postgres://bazaar:bazaar@localhost:5432/bazaar
# Public URL of the site (used for Discord OAuth redirect)
PUBLIC_URL=http://localhost:5173
API_PORT=8787
# Discord OAuth app (https://discord.com/developers/applications) -> redirect: ${PUBLIC_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Random string for signing session cookies
SESSION_SECRET=change-me
# Discord user ids that are admins (comma separated)
ADMIN_DISCORD_IDS=
